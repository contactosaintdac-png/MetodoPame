rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Canonical authority/private records/projections are server-written.
    // F0.6 adds orders, attempts, verified payment events, webhook receipts,
    // guest checkout capabilities, reconciliation issues and outbox jobs.
    // These documents contain financial authority, opaque-token hashes or PII;
    // browser create/update/delete is never valid. Safe status is served by API.
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function grantPath(uid) { return /databases/$(database)/documents/access_grants/$(uid); }
    function hasPermission(permission) {
      return isAuthenticated() && exists(grantPath(request.auth.uid))
        && get(grantPath(request.auth.uid)).data.schemaVersion == 1
        && get(grantPath(request.auth.uid)).data.active == true
        && get(grantPath(request.auth.uid)).data.permissionsVersion == 2
        && get(grantPath(request.auth.uid)).data.effectivePermissions is list
        && permission in get(grantPath(request.auth.uid)).data.effectivePermissions;
    }
    function isLegacyAdmin() {
      return isAuthenticated() && request.auth.token.keys().hasAll(['email', 'email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['metodopame.homedetail@gmail.com', 'contactosaintdac@gmail.com'];
    }
    function professionalPath(uid) { return /databases/$(database)/documents/professionals/$(uid); }
    function isOperationalProfessional(uid) {
      return isOwner(uid) && hasPermission('bookings.read_assigned') && exists(professionalPath(uid))
        && get(professionalPath(uid)).data.lifecycle.approval.state == 'approved'
        && get(professionalPath(uid)).data.lifecycle.operations.state == 'active';
    }
    function optionalString(data, key, max) { return !(key in data) || (data[key] is string && data[key].size() <= max); }
    function optionalBool(data, key) { return !(key in data) || data[key] is bool; }
    function optionalNumber(data, key, min, max) { return !(key in data) || (data[key] is number && data[key] >= min && data[key] <= max); }
    function recentTimestamp(value) { return value is timestamp && value <= request.time && value >= request.time - duration.value(5, 'm'); }
    function validLegacyUser(data) {
      return data.keys().hasOnly(['name','email','photoURL','role','createdAt','updatedAt','whatsapp','phone','neighborhood','isPreRegistered','referralCode','referrerUid'])
        && data.keys().hasAll(['email','role','createdAt']) && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role == 'client' && data.createdAt is timestamp && optionalString(data, 'name', 120)
        && optionalString(data, 'photoURL', 2048) && optionalString(data, 'whatsapp', 32) && optionalString(data, 'phone', 32)
        && optionalString(data, 'neighborhood', 120) && optionalString(data, 'referralCode', 80)
        && optionalString(data, 'referrerUid', 128) && optionalBool(data, 'isPreRegistered');
    }
    function validLegacyUserCreate(uid) {
      return isOwner(uid) && validLegacyUser(request.resource.data)
        && request.auth.token.email == request.resource.data.email && recentTimestamp(request.resource.data.createdAt);
    }
    function validLegacyUserUpdate(uid) {
      return isOwner(uid) && validLegacyUser(request.resource.data)
        && request.resource.data.email == resource.data.email && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function validTriage(data) {
      return data.keys().hasOnly(['cleaningDate','rooms','baths','floors','marble','wood','doubleGlass','chandeliers','frequency','address','phone'])
        && optionalString(data, 'cleaningDate', 32) && optionalString(data, 'frequency', 32)
        && optionalString(data, 'address', 500) && optionalString(data, 'phone', 32)
        && optionalNumber(data, 'rooms', 0, 100) && optionalNumber(data, 'baths', 0, 100)
        && optionalNumber(data, 'floors', 0, 20) && optionalBool(data, 'marble') && optionalBool(data, 'wood')
        && optionalBool(data, 'doubleGlass') && optionalBool(data, 'chandeliers');
    }
    function validChatRoot(data) {
      return data.keys().hasOnly(['clientName','clientEmail','lastMessageAt','lastMessageText','hasUnreadAdmin','clearChatAt'])
        && optionalString(data, 'clientName', 120) && optionalString(data, 'clientEmail', 254)
        && optionalString(data, 'lastMessageText', 4000) && optionalBool(data, 'hasUnreadAdmin')
        && (!('lastMessageAt' in data) || data.lastMessageAt is timestamp)
        && (!('clearChatAt' in data) || data.clearChatAt is timestamp);
    }
    function validUserMessage(data) {
      return data.keys().hasOnly(['role','text','createdAt']) && data.keys().hasAll(['role','text','createdAt'])
        && data.role == 'user' && data.text is string && data.text.size() >= 1 && data.text.size() <= 4000
        && recentTimestamp(data.createdAt);
    }
    function validReferral(data) {
      return data.keys().hasOnly(['referrerId','referrerName','referredId','referredName','referredEmail','bookingId','status','createdAt','updatedAt'])
        && data.keys().hasAll(['referrerId','referredName','referredEmail','status','createdAt'])
        && data.referrerId == request.auth.uid && data.status == 'pending'
        && optionalString(data, 'referrerName', 120) && optionalString(data, 'referredId', 128)
        && data.referredName is string && data.referredName.size() >= 1 && data.referredName.size() <= 120
        && data.referredEmail is string && data.referredEmail.size() >= 3 && data.referredEmail.size() <= 254
        && optionalString(data, 'bookingId', 128) && recentTimestamp(data.createdAt);
    }

    match /access_grants/{id} { allow read, write: if false; }
    match /candidate_applications/{id} { allow read, write: if false; }
    match /candidate_application_current/{id} { allow read, write: if false; }
    match /candidate_private/{id} { allow read, write: if false; }
    match /candidate_verifications/{id} { allow read, write: if false; }
    match /candidate_document_metadata/{id} { allow read, write: if false; }
    match /professionals/{id} { allow read, write: if false; }
    match /professional_private/{id} { allow read, write: if false; }
    match /professional_profiles/{id} { allow read, write: if false; }
    match /professional_capacity/{id} { allow read, write: if false; match /blocks/{blockId} { allow read, write: if false; } }
    match /client_profiles/{id} { allow read, write: if false; }
    match /client_private/{id} { allow read, write: if false; }
    match /residences/{id} { allow read, write: if false; }
    match /residence_private/{id} { allow read, write: if false; }
    match /residence_secrets/{id} { allow read, write: if false; }
    match /service_bookings/{id} { allow read, write: if false; }
    match /booking_requests/{id} { allow read, write: if false; }
    match /booking_holds/{id} { allow read, write: if false; }
    match /booking_series/{id} { allow read, write: if false; }
    match /capacity_slot_locks/{id} { allow read, write: if false; }
    match /booking_events/{id} { allow read, write: if false; }
    match /booking_command_receipts/{id} { allow read, write: if false; }
    match /booking_shadow_differences/{id} { allow read, write: if false; }
    match /orders/{id} { allow read, write: if false; }
    match /order_private/{id} { allow read, write: if false; }
    match /payment_attempts/{id} { allow read, write: if false; }
    match /payment_events/{id} { allow read, write: if false; }
    match /payment_event_applications/{id} { allow read, write: if false; }
    match /webhook_receipts/{id} { allow read, write: if false; }
    match /guest_purchase_intents/{id} { allow read, write: if false; }
    match /checkout_command_receipts/{id} { allow read, write: if false; }
    match /outbox_jobs/{id} { allow read, write: if false; }
    match /payment_reconciliation_issues/{id} { allow read, write: if false; }
    match /operations_booking_views/{id} { allow read, write: if false; }
    match /finance_booking_views/{id} { allow read, write: if false; }
    match /audit_log/{id} { allow read, write: if false; }
    // F0.7: LMS progress, answer snapshots, grades and command receipts are
    // server-owned. The browser receives only API projections without keys.
    match /lms_progress/{uid}/modules/{moduleId} { allow read, write: if false; }
    match /lms_module_attempts/{id} { allow read, write: if false; }
    match /lms_final_exam_attempts/{id} { allow read, write: if false; }
    match /lms_command_receipts/{id} { allow read, write: if false; }
    match /migration_runs/{id} { allow read, write: if false; }
    match /data_reconciliation_issues/{id} { allow read, write: if false; }

    match /candidate_self_views/{uid}/applications/{applicationId} { allow read: if isOwner(uid); allow write: if false; }
    match /professional_self_views/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /client_booking_views/{uid}/items/{bookingId} { allow read: if isOwner(uid); allow write: if false; }
    match /professional_booking_views/{uid}/items/{bookingId} { allow read: if isOperationalProfessional(uid); allow write: if false; }

    match /employees/{uid} {
      allow read: if isOwner(uid); allow create, update, delete: if false;
      // Historical records can include correct answers and are intentionally
      // inaccessible from Web SDK while compatibility is reviewed server-side.
      match /trainingProgress/{id} { allow read, write: if false; }
      match /final_exam_attempts/{id} { allow read, write: if false; }
    }
    match /employee_schedules/{uid}/blocks/{id} { allow read, write: if false; }
    match /reservas_index/{id} { allow read, write: if false; }
    match /{path=**}/bookings/{bookingId} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if isOwner(uid); allow create: if validLegacyUserCreate(uid); allow update: if validLegacyUserUpdate(uid); allow delete: if false;
      match /profile/triage { allow read: if isOwner(uid); allow create, update: if isOwner(uid) && validTriage(request.resource.data); allow delete: if false; }
      match /notifications/{id} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow create, delete: if false;
      }
      match /concierge_requests/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['type','date','details','status','createdAt'])
          && request.resource.data.type is string && request.resource.data.type.size() <= 120
          && request.resource.data.details is string && request.resource.data.details.size() <= 4000
          && request.resource.data.status == 'pending' && recentTimestamp(request.resource.data.createdAt);
        allow update, delete: if false;
      }
    }
    match /chats/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validChatRoot(request.resource.data)
        && (!('clientEmail' in request.resource.data) || request.resource.data.clientEmail == request.auth.token.email);
      allow delete: if false;
      match /messages/{id} { allow read: if isOwner(uid); allow create: if isOwner(uid) && validUserMessage(request.resource.data); allow update, delete: if false; }
    }
    match /referrals/{id} {
      allow read: if isAuthenticated() && resource.data.referrerId == request.auth.uid;
      allow create: if isAuthenticated() && validReferral(request.resource.data);
      allow update, delete: if false;
    }
    match /waitlist/{id} { allow read, write: if false; }

    match /modules/{id} { allow read: if hasPermission('training.consume') || hasPermission('training.content.manage'); allow write: if false; }
    match /lessons/{id} { allow read: if hasPermission('training.consume') || hasPermission('training.content.manage'); allow write: if false; }
    match /evaluations/{id} { allow read, write: if false; }
    match /final_exam_questions/{id} { allow read, write: if false; }
    match /certifications/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
